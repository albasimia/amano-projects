---
import ArrowLink from "albasimia-ssg-core/components/ArrowLink.astro";
import Container from "albasimia-ssg-core/components/Container.astro";
import Section from "albasimia-ssg-core/components/Section.astro";
import SectionHeader from "albasimia-ssg-core/components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCompanies } from "../lib/companies";
import { getPublishedProjects, type ProjectEntry } from "../lib/projects";

const professionalExperiences = await getCompanies();
const publishedProjects = await getPublishedProjects();
const projectsBySlug = new Map(publishedProjects.map((project) => [project.data.slug, project]));
const earlierProjectSlugs = ["hele-button", "quizzool", "rice-caster"];
const earlierProjects = earlierProjectSlugs
  .map((slug) => projectsBySlug.get(slug))
  .filter((project): project is ProjectEntry => project !== undefined);

const roots = [
  "映像",
  "Web技術",
  "インタラクティブ表現",
  "業務システム",
  "要件定義と運用設計",
  "現実世界を含むProject",
];

const capabilities = [
  {
    label: "OBSERVE",
    items: [
      "クライアントヒアリング",
      "現場観察",
      "業務分析",
      "ユーザー体験分析",
    ],
  },
  {
    label: "STRUCTURE",
    items: ["要件定義", "情報設計", "システム設計", "データ設計", "技術選定"],
  },
  {
    label: "IMPLEMENT",
    items: [
      "HTML / CSS / JavaScript / TypeScript",
      "Vue / React / Astro",
      "PHP / Laravel / WordPress",
      "Node.js / Electron",
      "Firebase / MySQL",
    ],
  },
  {
    label: "DELIVER AND OPERATE",
    items: [
      "Git / GitHub",
      "GitHub Actions",
      "Docker",
      "Cloudflare",
      "CMS",
      "保守・運用設計",
    ],
  },
  {
    label: "SHARE AND IMPROVE",
    items: [
      "コードレビュー",
      "技術指導",
      "ワークフロー標準化",
      "テスト",
      "ドキュメント作成",
    ],
  },
  {
    label: "CREATIVE",
    items: [
      "企画・コンセプト設計",
      "UI / UXデザイン",
      "写真・映像撮影、編集",
      "イラストレーション",
      "音楽制作",
      "DJ・選曲・サウンド演出",
    ],
  },
];
---

<SiteLayout
  pageClass="experience-page"
  breadcrumbs={[{ label: "EXPERIENCE" }]}
  meta={{
    title: "Experience",
    description:
      "現場と実装を往復して形成された、天野浩平の職務経験と制作能力。",
    canonicalPath: "/experience/",
  }}
>
  <header class="page-hero page-hero--statement">
    <Container>
      <p class="eyebrow">EXPERIENCE</p>
      <h1>実感と実装の往復</h1>
      <p>
        2016年から、VRアプリ、キャンペーンサイト、Webサイト、CMS、業務システムの設計・開発に従事。
      </p>
      <p>
        フロントエンド実装を起点に、顧客ヒアリング、要件定義、技術選定、チームへの技術展開、CI/CDや運用改善まで担当領域を広げてきました。
      </p>
    </Container>
  </header>

  <Section class="section--muted" labelledby="career-title">
    <Container>
      <SectionHeader
        eyebrow="CAREER PHASES"
        title={"実装から構造へ―― \n 役割の拡張"}
        id="career-title"
      />
      <div class="professional-list">
        {
          professionalExperiences.map(({ data }) => (
            <a class="professional-item" href={`/experience/${data.slug}/`}>
              <span class="professional-item__number">{data.number}</span>
              <div>
                <p>{data.label}</p>
                <h3>{data.company}</h3>
                <time>{data.period}</time>
              </div>
              <p>{data.summary}</p>
              <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section labelledby="roots-title">
    <Container>
      <SectionHeader
        eyebrow="ROOTS"
        title="体験の為に越境する制作"
        id="roots-title"
      />
      <ol class="roots-list">
        {
          roots.map((root, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              {root}
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section class="section--muted" labelledby="earlier-title">
    <Container>
      <SectionHeader
        eyebrow="EARLIER PERSONAL PROJECTS"
        title="現在につながる、以前の制作"
        id="earlier-title"
      />
      <div class="project-card-grid">
        {earlierProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Container>
  </Section>

  <Section labelledby="capabilities-title">
    <Container>
      <SectionHeader
        eyebrow="CAPABILITIES"
        title="目的の為に工程をまたぐ視点と感性"
        id="capabilities-title"
      />
      <div class="capability-grid">
        {
          capabilities.map((capability) => (
            <article>
              <>
                <h3>{capability.label}</h3>
                <ul>
                  {capability.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
      <ArrowLink class="section-end-link" href="/projects/">PROJECTS</ArrowLink>
    </Container>
  </Section>
</SiteLayout>
