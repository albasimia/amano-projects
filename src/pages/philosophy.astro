---
import ArrowLink from "albasimia-ssg-core/components/ArrowLink.astro";
import Container from "albasimia-ssg-core/components/Container.astro";
import Section from "albasimia-ssg-core/components/Section.astro";
import SectionHeader from "albasimia-ssg-core/components/SectionHeader.astro";
import { processCycle } from "../data/process";
import SiteLayout from "../layouts/SiteLayout.astro";

const makingPrinciples = [
  {
    label: "EXPERIENCE",
    title: "自分で確かめる。",
    description: "既存の答えをそのまま受け入れず、現場へ入り、実際の体験から考えます。",
  },
  {
    label: "STRUCTURE",
    title: "経験を、他者が扱える形へ変える。",
    description: "個人的な発見で終わらせず、名前、言葉、仕組み、プロダクトとして共有可能な構造へ変換します。",
  },
  {
    label: "INTERFACE",
    title: "名前はUIである。",
    description: "名前は対象を説明するだけではありません。人が何を期待し、どのように関わるかを変え、その後の行動を方向づけます。",
  },
];
---

<SiteLayout
  pageClass="philosophy-page"
  meta={{
    title: "Philosophy",
    description: "自分で確かめ、構造化し、次世代に渡す。人間、共同体、制作に対するアマノPJの哲学と、それを実践へ変える制作プロセス。",
    canonicalPath: "/philosophy/",
  }}
>
  <header class="page-hero page-hero--statement philosophy-hero">
    <Container>
      <p class="eyebrow">PHILOSOPHY</p>
      <h1>
        <span>自分で確かめ、</span>
        <span>構造化し、</span>
        <span>次世代に渡す。</span>
      </h1>
      <p class="philosophy-hero__intro">
        私たちは、名も残っていない多くの人々が積み重ねた、知識、技術、文化、営みの上に立っています。受け取ったものをただ信じるのではなく、自分の経験を通して確かめる。そこから得たものを、他者が扱える構造へ変え、自分の代で閉じずに次へ渡します。
      </p>
    </Container>
  </header>

  <Section class="philosophy-section" labelledby="inheritance-title">
    <Container>
      <SectionHeader eyebrow="01 — INHERITANCE" title="無名の偉人たちの上に立っている。" id="inheritance-title" />
      <div class="philosophy-copy">
        <p>私たちが当然のように使っている道具や言葉、制度や文化は、数え切れない人々の試行錯誤によって作られてきました。</p>
        <p>そのすべての名前を知ることはできません。それでも、受け取ったものに何を加え、何を次へ渡すのかを考えることはできます。</p>
        <blockquote class="philosophy-quote">受け取ったものを、自分の代で閉じない。</blockquote>
      </div>
    </Container>
  </Section>

  <Section class="philosophy-section section--muted" labelledby="human-title">
    <Container>
      <SectionHeader eyebrow="02 — HUMAN" title="人間は、完全には分かり合えない。それでも、分かり合おうとする。" id="human-title" />
      <div class="philosophy-copy">
        <p>人は、それぞれ異なる経験と認識を通して世界を見ています。だから、他者を完全に理解することはできません。</p>
        <p>しかし、分からないことを理由に関係を諦めるのではなく、言葉を尽くし、経験を共有し、理解しようとし続ける。その努力に、人間らしさがあると考えています。</p>
        <blockquote class="philosophy-quote">分かり合えなさを前提に、分かり合おうとし続ける。</blockquote>
      </div>
    </Container>
  </Section>

  <Section class="philosophy-section" labelledby="gemeinschaft-title">
    <Container>
      <SectionHeader eyebrow="03 — GEMEINSCHAFT" title="人間は、仲直りベースである。" id="gemeinschaft-title" />
      <div class="philosophy-copy">
        <p>人が関われば、誤解や衝突は必ず起こります。良い共同体とは、誰も対立しない場所ではありません。</p>
        <p>関係が揺らいだ時にも、話し直し、仲直りし、また共に始められる場所です。</p>

        <div class="philosophy-subsection">
          <h3>違うまま、共に生きられる場所をつくる。</h3>
          <p>共同体は、全員が同じ価値観になることで成立するものではありません。</p>
          <p>違いを残したまま、食事や労働、祭りや季節を共有し、繰り返し会うことで関係を育てていく。私は、プロダクトやイベントもまた、人と人のあいだに関係が生まれ、続いていくための場になり得ると考えています。</p>
        </div>

        <blockquote class="philosophy-refrain">
          <span>人間は完全には分かり合えない。</span>
          <span>それでも分かり合おうとする。</span>
          <span>壊れたなら、仲直りしてまた始める。</span>
        </blockquote>
      </div>
    </Container>
  </Section>

  <Section class="philosophy-section section--muted" labelledby="making-title">
    <Container>
      <SectionHeader eyebrow="04 — MAKING" title="作ること自体を、目的にはしない。" id="making-title" />
      <div class="philosophy-copy philosophy-copy--making">
        <p>現実の中で心が動き、既存の仕組みでは成立しない体験が見えた時、必要な構造を考え、実装します。</p>
        <p>作ることから始めるのではなく、実現したい体験と、それが成立する条件から考えます。</p>
      </div>
      <div class="making-principles">
        {makingPrinciples.map((principle, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p class="eyebrow">{principle.label}</p>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="process" class="philosophy-section" labelledby="full-process-title">
    <Container>
      <SectionHeader eyebrow="05 — PHILOSOPHY IN PRACTICE" title="哲学を、制作の循環へ変える。" id="full-process-title" />
      <p class="process-introduction">心が動いた場所へ入り、体験を構想し、構造化し、実装し、実世界で問い直す。その経験を社会へ接続し、次の制作へ蓄積するための循環です。</p>
      <ol class="full-process">
        {processCycle.map(({ title, description }, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  <Section class="philosophy-section philosophy-closing section--muted" labelledby="closing-title">
    <Container>
      <SectionHeader eyebrow="06 — CLOSING" title="受け取ったものを、自分の代で閉じない。" id="closing-title" />
      <div class="philosophy-copy">
        <p>現実の中で確かめ、他者が扱える形へ構造化し、次の誰かが使い、問い直し、更新できる状態で渡していく。</p>
        <p>それが、私がProjectを作る理由です。</p>
        <ArrowLink href="/projects/">VIEW PROJECTS</ArrowLink>
      </div>
    </Container>
  </Section>
</SiteLayout>
