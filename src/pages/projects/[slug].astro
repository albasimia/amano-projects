---
import { render } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import Container from "albasimia-ssg-core/components/Container.astro";
import MetaList from "albasimia-ssg-core/components/MetaList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getPublishedProjects, projectPeriod, statusLabels, type ProjectEntry } from "../../lib/projects";
import { getProjectMedia } from "../../lib/project-assets";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project, projects } }));
}

interface Props {
  project: ProjectEntry;
  projects: ProjectEntry[];
}

const { project, projects } = Astro.props;
const { Content } = await render(project);
const projectAccentStyle = project.data.accent
  ? `--color-accent:${project.data.accent};--project-accent:${project.data.accent}`
  : undefined;
const period = projectPeriod(project);
const projectMedia = getProjectMedia(project);
const hasDesktopAndMobileOnly = projectMedia.length === 2
  && projectMedia.every(({ type }) => type === "image")
  && projectMedia.some(({ kind }) => kind === "desktop")
  && projectMedia.some(({ kind }) => kind === "mobile");
const related = project.data.relatedProjects
  .map((slug) => projects.find(({ data }) => data.slug === slug))
  .filter((entry): entry is ProjectEntry => entry !== undefined);
const facts: Array<{ term: string; value: string | string[] }> = [];
if (period) facts.push({ term: "Period", value: period });
if (project.data.completedAt) facts.push({ term: "Initial completion", value: project.data.completedAt });
facts.push({ term: "Status", value: statusLabels[project.data.status] });
if (project.data.roles.length) facts.push({ term: "Role", value: project.data.roles });
facts.push({ term: "Field", value: project.data.fields });
if (project.data.technologies.length) facts.push({ term: "Technology", value: project.data.technologies });
---

<SiteLayout
  pageClass="project-page"
  breadcrumbs={[
    { label: "PROJECTS", href: "/projects/" },
    { label: project.data.title },
  ]}
  meta={{
    title: project.data.title,
    description: project.data.summary,
    canonicalPath: `/projects/${project.data.slug}/`,
    openGraph: { type: "article" },
  }}
>
  <article style={projectAccentStyle}>
    <header class="project-hero">
      <Container>
        <div class="project-hero__tags">
          <span class:list={["project-card__status", `project-card__status--${project.data.status}`]}>{statusLabels[project.data.status]}</span>
          <p class="project-card__fields project-hero__fields">
            <span>FIELD</span>
            <span>{project.data.fields.join(" / ")}</span>
          </p>
        </div>
        <h1>{project.data.title}</h1>
        <p class="project-hero__summary">{project.data.summary}</p>
      </Container>
    </header>

    {projectMedia.length > 0 && (
      <section class="project-media" aria-label="Project images and videos">
        <Container>
          <div class:list={["project-media__grid", {
            "project-media__grid--single": projectMedia.length === 1,
            "project-media__grid--desktop-mobile": hasDesktopAndMobileOnly,
          }]}>
            {projectMedia.map((media) => (
              <figure class:list={["project-media-item", `project-media-item--${media.kind}`, `project-media-item--${media.type}`]}>
                <figcaption>{media.label}</figcaption>
                {media.type === "image" ? (
                  <img src={media.src} alt={media.alt} loading="eager" decoding="async" />
                ) : (
                  <div class="project-media-item__video">
                    <iframe
                      src={media.src}
                      title={media.title}
                      loading="lazy"
                      allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </div>
                )}
              </figure>
            ))}
          </div>
        </Container>
      </section>
    )}

    <Container class="project-overview">
      <div>
        <p class="eyebrow">OVERVIEW</p>
        <h2>{project.data.intention}</h2>
      </div>
      <MetaList items={facts} />
      {(project.data.websiteUrl || project.data.repositoryUrl) && (
        <div class="project-overview__links">
          {project.data.websiteUrl && <ArrowLink href={project.data.websiteUrl}>WEBSITE</ArrowLink>}
          {project.data.repositoryUrl && <ArrowLink href={project.data.repositoryUrl}>GITHUB</ArrowLink>}
        </div>
      )}
    </Container>

    <Container size="prose" class="project-prose">
      <Content />
    </Container>

    <Container class="project-facts">
      <p class="eyebrow">FACTS</p>
      <MetaList items={facts} />
      <div class="project-overview__links">
        <ArrowLink href="/about/">ABOUT</ArrowLink>
        <ArrowLink href="/experience/">EXPERIENCE</ArrowLink>
      </div>
    </Container>

    {related.length > 0 && (
      <section class="related-projects" aria-labelledby="related-title">
        <Container>
          <p class="eyebrow">RELATED PROJECTS</p>
          <h2 id="related-title">経験は、次の体験へ……</h2>
          <div class="project-list">
            {related.map((entry) => <ProjectCard project={entry} />)}
          </div>
        </Container>
      </section>
    )}
  </article>
</SiteLayout>
