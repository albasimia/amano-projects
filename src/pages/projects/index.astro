---
import ProjectCard from "../../components/ProjectCard.astro";
import Container from "albasimia-ssg-core/components/Container.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getPublishedProjects } from "../../lib/projects";

const projects = await getPublishedProjects();
const clientProjects = projects.filter(({ data }) => data.projectType === "client");
const personalProjects = projects.filter(({ data }) => data.projectType === "personal");
const projectTabs = [
  { key: "client-work", label: "CLIENT WORK", count: clientProjects.length },
  { key: "personal-projects", label: "PERSONAL PROJECTS", count: personalProjects.length },
];
---

<SiteLayout
  pageClass="index-page"
  breadcrumbs={[{ label: "PROJECTS" }]}
  meta={{ title: "Projects", description: "課題の発見から検証まで、制作過程を記録したProject一覧。", canonicalPath: "/projects/" }}
>
  <header class="page-hero project-index-hero">
    <Container>
      <div class="project-index-hero__title">
        <p class="eyebrow">PROJECT INDEX</p>
        <h1>PROJECTS</h1>
      </div>
      <p>課題と制作過程の足跡</p>
    </Container>
  </header>
  <Container>
    <div class="project-tabs" data-project-tabs>
      <div class="project-tabs__list project-tabs__list--top" role="tablist" aria-label="Project種別" data-tab-position="top">
        {projectTabs.map((tab, index) => (
          <button
            id={`${tab.key}-tab`}
            type="button"
            role="tab"
            aria-selected={index === 0}
            aria-controls={tab.key}
            tabindex={index === 0 ? "0" : "-1"}
          >
            <span>{tab.label}</span><small>{tab.count}</small>
          </button>
        ))}
      </div>

      <section id="client-work" class="project-tab-panel" role="tabpanel" aria-labelledby="client-work-tab">
        <div class="project-list">
          {clientProjects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
        </div>
        <p class="project-tab-panel__note">その他非公開案件多数</p>
      </section>

      <section id="personal-projects" class="project-tab-panel" role="tabpanel" aria-labelledby="personal-projects-tab" hidden>
        <div class="project-list">
          {personalProjects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
        </div>
      </section>

      <div class="project-tabs__list project-tabs__list--bottom" role="tablist" aria-label="Project種別（一覧末尾）" data-tab-position="bottom">
        {projectTabs.map((tab, index) => (
          <button
            id={`${tab.key}-tab-bottom`}
            type="button"
            role="tab"
            aria-selected={index === 0}
            aria-controls={tab.key}
            tabindex={index === 0 ? "0" : "-1"}
          >
            <span>{tab.label}</span><small>{tab.count}</small>
          </button>
        ))}
      </div>
    </div>
  </Container>
</SiteLayout>

<script>
  const tabsRoot = document.querySelector<HTMLElement>("[data-project-tabs]");

  if (tabsRoot) {
    const tabLists = Array.from(tabsRoot.querySelectorAll<HTMLElement>("[role='tablist']"));
    const tabs = Array.from(tabsRoot.querySelectorAll<HTMLButtonElement>("[role='tab']"));
    const panels = Array.from(tabsRoot.querySelectorAll<HTMLElement>("[role='tabpanel']"));

    const activateTab = (panelId: string, updateHash = true) => {
      tabs.forEach((item) => {
        const selected = item.getAttribute("aria-controls") === panelId;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.id !== panelId; });

      if (updateHash && panelId) history.replaceState(null, "", `#${panelId}`);
    };

    tabLists.forEach((tabList) => {
      const localTabs = Array.from(tabList.querySelectorAll<HTMLButtonElement>("[role='tab']"));

      localTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          const panelId = tab.getAttribute("aria-controls");
          if (!panelId) return;
          activateTab(panelId);

          if (tabList.dataset.tabPosition === "bottom") {
            document.getElementById(panelId)?.scrollIntoView({
              behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
              block: "start",
            });
          }
        });
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          const direction = event.key === "ArrowRight" ? 1 : -1;
          const nextTab = localTabs[(index + direction + localTabs.length) % localTabs.length];
          const panelId = nextTab.getAttribute("aria-controls");
          if (panelId) activateTab(panelId);
          nextTab.focus();
        });
      });
    });

    const hashTab = tabs.find((tab) => `#${tab.getAttribute("aria-controls")}` === window.location.hash);
    const hashPanelId = hashTab?.getAttribute("aria-controls");
    if (hashPanelId) activateTab(hashPanelId, false);
  }
</script>
