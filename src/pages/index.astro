---
import ArrowLink from "albasimia-ssg-core/components/ArrowLink.astro";
import Container from "albasimia-ssg-core/components/Container.astro";
import Section from "albasimia-ssg-core/components/Section.astro";
import SectionHeader from "albasimia-ssg-core/components/SectionHeader.astro";
import HomeProjectCard from "../components/HomeProjectCard.astro";
import { processCycle } from "../data/process";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPublishedProjects, type ProjectEntry } from "../lib/projects";

const projects = await getPublishedProjects();
const featuredProjects = projects.filter(({ data }) => data.featured).slice(0, 4);
const inProgressProject = projects.find(({ data }) => data.slug === "kaka-see");

const pointOnCircle = (angle: number, radius: number) => {
  const radians = (angle * Math.PI) / 180;
  return { x: 50 + radius * Math.cos(radians), y: 50 + radius * Math.sin(radians) };
};

const processSteps = processCycle.map((item, index) => {
  const stepAngle = 360 / processCycle.length;
  const nodeAngle = -90 + index * stepAngle;
  const start = pointOnCircle(nodeAngle + 4, 38);
  const end = pointOnCircle(nodeAngle + stepAngle - 4, 38);
  const node = pointOnCircle(nodeAngle, 44);

  return {
    ...item,
    number: String(index + 1).padStart(2, "0"),
    path: `M ${start.x.toFixed(3)} ${start.y.toFixed(3)} A 38 38 0 0 1 ${end.x.toFixed(3)} ${end.y.toFixed(3)}`,
    style: `--node-x:${node.x.toFixed(3)}%;--node-y:${node.y.toFixed(3)}%`,
  };
});

const professionalExperience = [
  { title: "KAYAC", subtitle: "Interactive Frontend", description: "キャンペーンサイト、ゲーム型コンテンツ、インタラクティブ表現の実装。" },
  { title: "SUBARU", subtitle: "Large-scale Website Operations", description: "大規模公式サイトの制作、長期運用、更新設計、CMS構築。" },
  { title: "BOOKMATE", subtitle: "Requirements & System Design", description: "クライアントヒアリング、要件定義、業務システム設計と継続運用。" },
];

const identities = [
  { number: "01", label: "LEGAL IDENTITY", name: "天野 浩平", description: "社会と契約する入口" },
  { number: "02", label: "CREATIVE IDENTITY", name: "ｶﾀﾙｼｽﾜﾀﾘ", description: "現実を経験し、課題を観測する入口" },
  { number: "03", label: "ENGINEERING IDENTITY", name: "albasimia", description: "課題を構造化し、実装する入口" },
];

function projectStyle(project: ProjectEntry): string | undefined {
  return project.data.accent ? `--project-accent:${project.data.accent}` : undefined;
}
---

<SiteLayout
  pageClass="home-page"
  meta={{ titleMode: "absolute", title: "アマノPROJECTS", canonicalPath: "/" }}
>
  <section id="top" class="home-hero" aria-labelledby="home-title">
    <picture class="home-hero__media">
      <source media="(max-width: 767px)" srcset="/images/home-hero-mobile.jpg" />
      <img
        src="/images/home-hero-desktop.jpg"
        width="1280"
        height="720"
        alt="MacBook、自作キーボード、ACK05、ヘッドフォン、はんだごてが置かれた制作環境"
        fetchpriority="high"
      />
    </picture>
    <Container class="home-hero__inner">
      <h1 id="home-title">
        <span>作らなくていいなら</span>
        <span>作りたくない。</span>
        <span class="home-hero__break">でも作らずには</span>
        <span>いられない。</span>
      </h1>
      <div class="home-hero__footer">
        <p>Projects, process, and proof.</p>
        <div class="home-hero__links">
          <a class="home-hero__button home-hero__button--primary" href="/projects/">VIEW PROJECTS <span aria-hidden="true">→</span></a>
          <a class="home-hero__button" href="/about/">ABOUT</a>
        </div>
      </div>
    </Container>
  </section>

  <Section class="home-section home-process" labelledby="process-title">
    <Container>
      <SectionHeader eyebrow="PROCESS" title="経験が、構造になる。" id="process-title" />
      <div class="process-cycle">
        <svg class="process-cycle__track" viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <marker id="process-arrow" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
              <path d="M0,0 L5,2.5 L0,5 Z"></path>
            </marker>
          </defs>
          {processSteps.map((item) => <path d={item.path} marker-end="url(#process-arrow)"></path>)}
        </svg>
        <ol class="process-cycle__nodes">
          {processSteps.map((item) => (
            <li style={item.style}><span>{item.number}</span><strong>{item.title}</strong></li>
          ))}
        </ol>
        <p class="process-cycle__center"><span>制作は、成果物ではなく</span><span>循環として続いていく。</span></p>
      </div>
      <ArrowLink href="/philosophy/#process">VIEW THE FULL PROCESS</ArrowLink>
    </Container>
  </Section>

  <Section class="home-section home-pickup" labelledby="pickup-title">
    <Container>
      <div class="home-section-heading home-section-heading--inline">
        <p class="eyebrow" id="pickup-title">PICK UP</p>
        <ArrowLink href="/projects/">VIEW ALL</ArrowLink>
      </div>
      <div class="home-project-grid">
        {featuredProjects.map((project) => <HomeProjectCard project={project} />)}
      </div>
    </Container>
  </Section>

  {inProgressProject && (
    <Section class="home-section home-progress" labelledby="progress-title">
      <Container>
        <div class="home-section-heading">
          <p class="eyebrow" id="progress-title">IN PROGRESS</p>
        </div>
        <article class="progress-project" style={projectStyle(inProgressProject)}>
          <a class="progress-project__media" href={`/projects/${inProgressProject.data.slug}/`} aria-label={`${inProgressProject.data.title}の詳細を見る`}>
            {inProgressProject.data.heroImage ? (
              <img src={inProgressProject.data.heroImage} alt="" loading="lazy" />
            ) : (
              <span class="progress-project__placeholder" aria-hidden="true">
                <span>FIELD NOTE</span>
                <strong>{inProgressProject.data.title}</strong>
              </span>
            )}
          </a>
          <div class="progress-project__body">
            <p class="eyebrow">CURRENT PROJECT</p>
            <h2><a href={`/projects/${inProgressProject.data.slug}/`}>{inProgressProject.data.title}</a></h2>
            <dl class="progress-project__meta">
              <div><dt>STATUS</dt><dd>IN DEVELOPMENT</dd></div>
              <div><dt>CURRENT PHASE</dt><dd>Phase 0 — Sensor Reading</dd></div>
            </dl>
            <p>{inProgressProject.data.summary}</p>
            <ArrowLink href={`/projects/${inProgressProject.data.slug}/`}>VIEW PROJECT</ArrowLink>
          </div>
        </article>
      </Container>
    </Section>
  )}

  <Section class="home-section home-professional" labelledby="professional-title">
    <Container>
      <div class="home-section-heading">
        <p class="eyebrow" id="professional-title">PROFESSIONAL EXPERIENCE</p>
      </div>
      <div class="professional-list">
        {professionalExperience.map((item, index) => (
          <a href="/experience/" class="professional-item">
            <span class="professional-item__number">{String(index + 1).padStart(2, "0")}</span>
            <div><p>{item.subtitle}</p><h3>{item.title}</h3></div>
            <p>{item.description}</p>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <ArrowLink href="/experience/">VIEW EXPERIENCE</ArrowLink>
    </Container>
  </Section>

  <Section class="home-section home-identities" labelledby="identities-title">
    <Container>
      <SectionHeader eyebrow="IDENTITIES" title="ひとりの人間が、異なる入口から現実へ接続する。" id="identities-title" />
      <div class="identity-grid">
        {identities.map((identity) => (
          <article>
            <span class="identity-grid__number">{identity.number}</span>
            <p class="eyebrow">{identity.label}</p>
            <h3>{identity.name}</h3>
            <p>{identity.description}</p>
          </article>
        ))}
      </div>
      <ArrowLink href="/about/">ABOUT THESE INTERFACES</ArrowLink>
    </Container>
  </Section>
</SiteLayout>
