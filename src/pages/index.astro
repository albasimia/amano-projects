---
import ArrowLink from "../components/ArrowLink.astro";
import Container from "albasimia-ssg-core/components/Container.astro";
import Section from "albasimia-ssg-core/components/Section.astro";
import SectionHeader from "albasimia-ssg-core/components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projectSelections } from "../data/project-selections";
import { processCycle } from "../data/process";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCompanies } from "../lib/companies";
import { getPublishedProjects, statusLabels, type ProjectEntry } from "../lib/projects";

const projects = await getPublishedProjects();
const professionalExperiences = await getCompanies();
const projectBySlug = new Map(projects.map((project) => [project.data.slug, project]));
const selectHomeProjects = (slugs: readonly string[]) => slugs
  .map((slug) => projectBySlug.get(slug))
  .filter((project): project is ProjectEntry => project !== undefined);
const pickUpProjects = selectHomeProjects(projectSelections.home.pickUp);
const featuredClientProjects = selectHomeProjects(projectSelections.home.clientWork);
const featuredPersonalProjects = selectHomeProjects(projectSelections.home.personalProjects);
const inProgressProject = projectBySlug.get(projectSelections.home.inProgress);
const inProgressImage = inProgressProject?.data.heroImage;

const pointOnCircle = (angle: number, radius: number) => {
  const radians = (angle * Math.PI) / 180;
  return { x: 50 + radius * Math.cos(radians), y: 50 + radius * Math.sin(radians) };
};

const processSteps = processCycle.map((item, index) => {
  const stepAngle = 360 / processCycle.length;
  const nodeAngle = -90 + index * stepAngle;
  const start = pointOnCircle(nodeAngle + 4, 38);
  const end = pointOnCircle(nodeAngle + stepAngle - 4, 38);
  const node = pointOnCircle(nodeAngle, 44);

  return {
    ...item,
    number: String(index + 1).padStart(2, "0"),
    path: `M ${start.x.toFixed(3)} ${start.y.toFixed(3)} A 38 38 0 0 1 ${end.x.toFixed(3)} ${end.y.toFixed(3)}`,
    style: `--node-x:${node.x.toFixed(3)}%;--node-y:${node.y.toFixed(3)}%`,
  };
});

const identities = [
  { label: "LEGAL IDENTITY", name: "天野 浩平", description: "社会と契約する入口" },
  { label: "CREATIVE IDENTITY", name: "ｶﾀﾙｼｽﾜﾀﾘ", description: "現実を経験し、課題を観測する入口" },
  { label: "ENGINEERING IDENTITY", name: "albasimia", description: "課題を構造化し、実装する入口" },
];

function projectStyle(project: ProjectEntry): string | undefined {
  return project.data.accent ? `--project-accent:${project.data.accent}` : undefined;
}
---

<SiteLayout
  pageClass="home-page"
  meta={{ titleMode: "absolute", title: "アマノPROJECTS", canonicalPath: "/" }}
>
  <section id="top" class="home-hero" aria-labelledby="home-title">
    <picture class="home-hero__media">
      <source media="(max-width: 767px)" srcset="/images/home-hero-mobile.jpg" />
      <img
        src="/images/home-hero-desktop.jpg"
        width="1280"
        height="720"
        alt="MacBook、自作キーボード、ACK05、ヘッドフォン、はんだごてが置かれた制作環境"
        fetchpriority="high"
      />
    </picture>
    <Container class="home-hero__inner">
      <h1 id="home-title">
        <span>構想から、構造へ。</span>
        <span class="home-hero__break">構造から、実装へ。</span>
        <span class="home-hero__accent-copy">そして、<br class="home-hero__sp-break" />人が動くところまで。</span>
      </h1>
      <div class="home-hero__footer">
        <div class="home-hero__links">
          <a class="home-hero__button home-hero__button--primary" href="/projects/">VIEW PROJECTS <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </Container>
  </section>

  <Section class="home-section home-about section--muted" labelledby="home-about-title">
    <Container>
      <div class="home-about__layout">
        <figure class="home-about__portrait">
          <img src="/images/about-profile.webp" alt="天野 浩平のプロフィール写真" width="853" height="1280" loading="lazy" />
        </figure>
        <div class="home-about__body">
          <p class="eyebrow">ABOUT</p>
          <p class="profile-kana">アマノ コウヘイ</p>
          <h2 id="home-about-title">天野 浩平</h2>
          <p>現実の中で心が動き、既存の仕組みでは成立しない体験が見えた時、必要な構造を考え、実装します。</p>
          <ArrowLink class="section-end-link" href="/about/">VIEW ABOUT</ArrowLink>
        </div>
      </div>
    </Container>
  </Section>

  <Section class="home-section home-process" labelledby="process-title">
    <Container>
      <SectionHeader eyebrow="PROCESS" title="経験が、構造になる" id="process-title" />
      <div class="process-cycle">
        <div class="process-cycle__track-clip" aria-hidden="true">
          <svg class="process-cycle__track" viewBox="0 0 100 100">
            <defs>
              <marker id="process-arrow" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
                <path d="M0,0 L5,2.5 L0,5 Z"></path>
              </marker>
            </defs>
            {processSteps.map((item) => <path d={item.path} marker-end="url(#process-arrow)"></path>)}
          </svg>
        </div>
        <ol class="process-cycle__nodes">
          {processSteps.map((item) => (
            <li style={item.style}><span>{item.number}</span><strong>{item.title}</strong></li>
          ))}
        </ol>
        <p class="process-cycle__center"><span>制作の循環</span></p>
      </div>
      <ArrowLink class="section-end-link" href="/philosophy/#process">VIEW THE FULL PROCESS</ArrowLink>
    </Container>
  </Section>

  <Section class="home-section home-work" labelledby="work-title">
    <Container>
      <SectionHeader eyebrow="PROJECTS" title="生まれたもの、生まれるもの" id="work-title" />

      <div class="home-work-group">
        <div class="home-section-heading">
          <p class="eyebrow">PICK UP</p>
        </div>
        <div class="project-card-grid">
          {pickUpProjects.map((project) => <ProjectCard project={project} />)}
        </div>
        <ArrowLink class="section-end-link" href="/projects/">VIEW ALL PROJECTS</ArrowLink>
      </div>

      <div class="home-work-group">
        <div class="home-section-heading">
          <p class="eyebrow">CLIENT WORK</p>
        </div>
        <div class="project-card-grid">
          {featuredClientProjects.map((project) => <ProjectCard project={project} />)}
        </div>
        <ArrowLink class="section-end-link" href="/projects/#client-work">VIEW ALL PROJECTS</ArrowLink>
      </div>

      <div class="home-work-group">
        <div class="home-section-heading">
          <p class="eyebrow">PERSONAL PROJECTS</p>
        </div>
        <div class="project-card-grid">
          {featuredPersonalProjects.map((project) => <ProjectCard project={project} />)}
        </div>
        <ArrowLink class="section-end-link" href="/projects/#personal-projects">VIEW ALL PROJECTS</ArrowLink>
      </div>

      {inProgressProject && (
        <div class="home-work-group home-progress-group">
          <div class="home-section-heading">
            <p class="eyebrow">IN PROGRESS</p>
          </div>
        <article class="progress-project" style={projectStyle(inProgressProject)}>
          <header class="progress-project__identity">
            <div class="project-card__badges">
              <span class:list={["project-card__status", `project-card__status--${inProgressProject.data.status}`]}>{statusLabels[inProgressProject.data.status]}</span>
            </div>
            <p class="project-card__fields">
              <span>FIELD</span>
              <span>{inProgressProject.data.fields.join(" / ")}</span>
            </p>
            <h3><a href={`/projects/${inProgressProject.data.slug}/`}>{inProgressProject.data.title}</a></h3>
          </header>
          <div class="progress-project__phase">
            <p class="eyebrow">CURRENT PHASE</p>
            <h4>{inProgressProject.data.currentPhase?.label}</h4>
            <p>{inProgressProject.data.currentPhase?.description}</p>
          </div>
          <div class="progress-project__aside">
            {inProgressImage && (
              <a class="progress-project__media" href={`/projects/${inProgressProject.data.slug}/`} aria-label={`${inProgressProject.data.title}の詳細を見る`}>
              <img
                src={inProgressImage.src}
                alt={inProgressImage.alt}
                loading="lazy"
                style={inProgressImage.position ? `object-position:${inProgressImage.position}` : undefined}
              />
              </a>
            )}
            <ArrowLink href={`/projects/${inProgressProject.data.slug}/`}>VIEW PROJECT</ArrowLink>
          </div>
        </article>
        </div>
      )}
    </Container>
  </Section>

  <Section class="home-section home-professional" labelledby="professional-title">
    <Container>
      <SectionHeader
        eyebrow="PROFESSIONAL EXPERIENCE"
        title={"実装から構造へ――\n役割の拡張"}
        id="professional-title"
      />
      <div class="professional-list">
        {professionalExperiences.map(({ data }) => (
          <a href={`/experience/${data.slug}/`} class="professional-item">
            <span class="professional-item__number">{data.number}</span>
            <div>
              <p>{data.label}</p>
              <h3>{data.shortName}</h3>
              <time>{data.period}</time>
            </div>
            <p>{data.summary}</p>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <ArrowLink class="section-end-link" href="/experience/">VIEW EXPERIENCE</ArrowLink>
    </Container>
  </Section>

  <Section class="home-section home-identities" labelledby="identities-title">
    <Container>
      <SectionHeader eyebrow="IDENTITIES" title="ひとりの人間、３つのInterface" id="identities-title" />
      <div class="identity-grid">
        {identities.map((identity) => (
          <article>
            <p class="eyebrow">{identity.label}</p>
            <h3 class:list={{ "identity-name--watarino": identity.label === "CREATIVE IDENTITY" }}>{identity.name}</h3>
            <p>{identity.description}</p>
          </article>
        ))}
      </div>
      <ArrowLink class="section-end-link" href="/about/">ABOUT THESE INTERFACES</ArrowLink>
    </Container>
  </Section>
</SiteLayout>

<style>
  .home-hero__sp-break {
    display: none;
  }

  @media (max-width: 767px) {
    .home-hero__sp-break {
      display: inline;
    }
  }
</style>
