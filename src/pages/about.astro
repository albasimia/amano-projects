---
import ArrowLink from "../components/ArrowLink.astro";
import Container from "albasimia-ssg-core/components/Container.astro";
import Section from "albasimia-ssg-core/components/Section.astro";
import SectionHeader from "albasimia-ssg-core/components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const identities = [
  { label: "LEGAL IDENTITY", name: "天野 浩平", description: "契約、就職、職務経歴など、社会制度上の本人として接続するInterface。" },
  { label: "CREATIVE IDENTITY", name: "ｶﾀﾙｼｽﾜﾀﾘ", description: "DJ、イベント、農業、フィールドワークを通して、現実の場へ入り、体験と課題を観測するInterface。" },
  { label: "ENGINEERING IDENTITY", name: "albasimia", description: "観測した課題を構造化し、Web、IoT、Tool、Architectureとして実装するInterface。" },
];
---

<SiteLayout
  pageClass="about-page"
  breadcrumbs={[{ label: "ABOUT" }]}
  meta={{ title: "About", description: "天野浩平と、社会へ接続する3つのInterface。", canonicalPath: "/about/" }}
>
  <header class="about-profile-page">
    <Container>
      <p class="eyebrow">ABOUT</p>
      <div class="about-profile">
        <div class="about-profile__header">
          <p class="profile-kana">アマノ コウヘイ</p>
          <h1>天野 浩平</h1>
        </div>
        <figure class="about-profile__portrait">
          <img
            src="/images/about-profile.webp"
            alt="天野 浩平のプロフィール写真"
            width="853"
            height="1280"
            decoding="async"
          />
        </figure>
        <div class="about-profile__body">
          <p class="about-profile__statement">作ること自体を、<br>目的にしない。</p>
          <p>幼少の頃から外遊びが嫌いで、粘土をこねるか、絵を描くかの日々を過ごしていた。</p>
          <p>高校在学中、リーマンショックの影響を受けて父の会社が倒産。アルバイト中心の生活となり、4年かけて高校を卒業。</p>
          <p>なんとか東京工芸大学へ進学したものの、金銭的な事情から除籍となる。その後、両親の離婚をきっかけに奨学金を利用できるようになり、情報科学専門学校へ入り直す。</p>
          <p>卒業後はエンジニアとして働いてきたが、次第に、現実の生活から切り離された「仕事を成立させるための仕事」をしているような感覚に違和感を覚えるようになる。</p>
          <p>その違和感を確かめるため、八王子市へ移り、八王子農業塾に入塾。同じ頃、DJという文化に出会い、音楽を中心としたイベントの中にゲマインシャフトを見出す。<br>現在は、農作業をするか、DJをしながら野菜を配るか。そんな週末を過ごしている。</p>
          <p>現実の中で心が動き、既存の仕組みでは成立しない体験が見えたとき、必要な構造を考え、形が見えたら実装せずにはいられない。</p>
          <p>アマノPROJECTSは、僕の人生を構造化し、SSG（Static Site Generation）したWebサイトである。</p>
          <div class="about-profile__links">
            <ArrowLink href="/philosophy/">PHILOSOPHY</ArrowLink>
            <ArrowLink href="https://github.com/albasimia">GITHUB</ArrowLink>
          </div>
        </div>
      </div>
    </Container>
  </header>

  <Section id="interfaces" class="section--muted" labelledby="interfaces-title">
    <Container>
      <SectionHeader eyebrow="IDENTITIES AS INTERFACES" title="同じ人間、３つのInterface" id="interfaces-title" />
      <div class="identity-list">
        {identities.map((identity) => (
          <article>
            <div><p class="eyebrow">{identity.label}</p><h3 class:list={{ "identity-name--watarino": identity.label === "CREATIVE IDENTITY" }}>{identity.name}</h3></div>
            <p>{identity.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>
</SiteLayout>
