---
import type { ProjectEntry } from "../lib/projects";
import { projectPeriod, statusLabels } from "../lib/projects";

interface Props {
  project: ProjectEntry;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const href = `/projects/${project.data.slug}/`;
const style = project.data.accent ? `--project-accent:${project.data.accent}` : undefined;
const cardImage = project.data.heroImage;
const period = projectPeriod(project);
---

<article class="project-card" style={style}>
  <a class="project-card__link" href={href} aria-label={`${project.data.title}の詳細を見る`}>
    <div class:list={["project-card__visual", { "project-card__visual--placeholder": !cardImage }]}>
      {cardImage ? (
        <img
          src={cardImage.src}
          alt={cardImage.alt}
          loading="lazy"
          decoding="async"
          style={cardImage.position ? `object-position:${cardImage.position}` : undefined}
        />
      ) : (
        <span class="project-card__placeholder" aria-hidden="true">{project.data.title}</span>
      )}
    </div>
    <div class="project-card__body">
      <div class="project-card__badges">
        <span class:list={["project-card__status", `project-card__status--${project.data.status}`]}>{statusLabels[project.data.status]}</span>
      </div>
      {period && (
        <p class="project-card__period">
          <span>PERIOD</span>
          <span>{period}</span>
        </p>
      )}
      <p class="project-card__fields">
        <span>FIELD</span>
        <span>{project.data.fields.join(" / ")}</span>
      </p>
      <Heading>{project.data.title}</Heading>
      <p class="project-card__summary">{project.data.summary}</p>
      <span class="project-card__more">VIEW PROJECT <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<script>
  const cardViewport = window.matchMedia("(max-width: 767px)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let cardObserver: IntersectionObserver | undefined;

  const clearActiveCards = () => {
    document.querySelectorAll(".project-card.is-scroll-active").forEach((card) => {
      card.classList.remove("is-scroll-active");
    });
  };

  const observeProjectCards = () => {
    cardObserver?.disconnect();
    clearActiveCards();

    if (!cardViewport.matches || reducedMotion.matches) return;

    cardObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.closest(".project-card")?.classList.toggle("is-scroll-active", entry.isIntersecting);
      });
    }, {
      rootMargin: "-42% 0px -42% 0px",
      threshold: 0,
    });

    document.querySelectorAll(".project-card__visual").forEach((visual) => cardObserver?.observe(visual));
  };

  observeProjectCards();
  cardViewport.addEventListener("change", observeProjectCards);
  reducedMotion.addEventListener("change", observeProjectCards);
</script>
