---
const pathname = Astro.url.pathname;
const navigation = [
  { href: "/projects/", label: "PROJECTS", current: pathname.startsWith("/projects/") },
  { href: "/about/", label: "ABOUT", current: pathname.startsWith("/about/") },
  { href: "/philosophy/", label: "PHILOSOPHY", current: pathname.startsWith("/philosophy/") },
  { href: "/experience/", label: "EXPERIENCE", current: pathname.startsWith("/experience/") },
];
---

<header class="site-header">
  <a class="site-brand" href="/" aria-label="アマノPROJECTS トップへ">
    <span class="site-brand__amano">アマノ</span><span class="site-brand__projects">PROJECTS</span>
  </a>
  <nav class="site-navigation-desktop" aria-label="メインナビゲーション">
    {navigation.map((item) => (
      <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>
  <details class="site-navigation-mobile">
    <summary aria-label="メニューを開閉する">
      <span class="site-navigation__label">MENU</span>
      <span class="site-navigation__icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </summary>
    <nav aria-label="メインナビゲーション">
      {navigation.map((item) => (
        <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</header>

<script>
  const mobileNavigation = document.querySelector<HTMLDetailsElement>(".site-navigation-mobile");

  if (mobileNavigation) {
    document.addEventListener("pointerdown", (event) => {
      if (!mobileNavigation.open) return;
      if (event.target instanceof Node && !mobileNavigation.contains(event.target)) {
        mobileNavigation.open = false;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileNavigation.open) {
        mobileNavigation.open = false;
        mobileNavigation.querySelector("summary")?.focus();
      }
    });

    mobileNavigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNavigation.open = false;
      });
    });
  }
</script>
